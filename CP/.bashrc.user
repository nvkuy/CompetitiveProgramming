# For competitive programming

CP_DIR_PATH="$HOME/CompetitiveProgramming/"
TEMPLATE_FILE_PATH="$CP_DIR_PATH/CP/basic_temp.cpp"
MAKE_FILE_PATH="$CP_DIR_PATH/CP/Makefile"
VSCODE_DEBUG_FILE_PATH="$CP_DIR_PATH/CP/.vscode/"

SOLVE_FILE='solve.cpp'

go_prob() {
    prob_name=$(echo "$1" | xargs)
    if [[ -d "$prob_name" ]]; then
        cd $prob_name
        code . --reuse-window --goto $SOLVE_FILE
    elif [[ -d "../$prob_name" ]]; then
        cd ../$prob_name
        code . --reuse-window --goto $SOLVE_FILE
    else
        echo "Can't find problem $prob_name."
    fi
}

new_prob() {
    prob_name=$(echo "$1" | xargs)
    if [[ -d "$prob_name" ]]; then
        echo "Problem $prob_name already exists."
        return
    fi
    mkdir $prob_name
    cd $prob_name
    cat $TEMPLATE_FILE_PATH > $SOLVE_FILE
    cp -r $VSCODE_DEBUG_FILE_PATH $(pwd)
    cp $MAKE_FILE_PATH $(pwd)
    mkdir build
    printf '.vscode/\nMakefile\nbuild/\n' > .gitignore
    code . --reuse-window --goto $SOLVE_FILE
}

# For work



